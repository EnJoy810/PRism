# LLM 配置（优先级高于 prism.yaml 对应字段）
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 可选：旧版 DeepSeek API Key（仅当 LLM_API_KEY 未设置时生效）
# DEEPSEEK_API_KEY=sk-your_deepseek_api_key

# CLI 审查私有仓库时需要（获取：GitHub Settings → Developer settings → Personal access tokens）
GITHUB_TOKEN=ghp_your_github_pat

# GitHub App 部署时需要（Settings → Developer settings → GitHub Apps）
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# 可选：队列模式（默认 redis://localhost:6379/0）
REDIS_URL=redis://localhost:6379/0

# 可选：LangSmith 可观测性
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_your_langsmith_api_key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
